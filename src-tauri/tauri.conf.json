{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pumr",
  "version": "0.3.0",
  "identifier": "dev.pumr.app",
  "build": {
    "frontendDist": "../dist/pumr/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "pumr",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyMkQyOTM4MUVBNkFGMjkKUldRcHI2WWVPQ2t0Y2kwd2QreFFmampaTnBiNHViNGFDOEFDcTd0cnlGMHgxcXhoVk0zR3loTjcK",
      "endpoints": [
        "https://github.com/swordmangofar/pumr/releases/latest/download/latest.json"
      ]
    }
  }
}
